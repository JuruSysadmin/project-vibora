; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="project-vibora"
run/main_scene="res://scenes/level_01.tscn"
config/features=PackedStringArray("4.7", "C#")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="res://art/sons/barras.tres"

[autoload]

PhantomCameraManager="*res://addons/phantom_camera/scripts/managers/phantom_camera_manager.gd"
MCPRuntimeServer="*res://addons/godot_mcp_toolkit/runtime/mcp_runtime_server.gd"

[dotnet]

project/assembly_name="project-vibora"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp/plugin.cfg", "res://addons/godot_mcp_toolkit/plugin.cfg", "res://addons/phantom_camera/plugin.cfg")

