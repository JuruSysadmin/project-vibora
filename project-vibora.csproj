<Project Sdk="Godot.NET.Sdk/4.7.2">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <RootNamespace>projectvibora</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="com.IvanMurzak.ReflectorNet" Version="5.5.1" />
    <PackageReference Include="com.IvanMurzak.McpPlugin" Version="8.14.0" />
    <PackageReference Include="com.IvanMurzak.Rql" Version="0.3.0" Condition="'$(Configuration)' != 'ExportDebug' and '$(Configuration)' != 'ExportRelease'" />
    <PackageReference Include="com.IvanMurzak.CodeExec" Version="0.4.0" Condition="'$(GodotMcpCodeExecInGame)' == 'true' or ('$(Configuration)' != 'ExportDebug' and '$(Configuration)' != 'ExportRelease')" />
    <PackageReference Include="com.IvanMurzak.CodeExec.Roslyn" Version="0.4.0" Condition="'$(GodotMcpCodeExecInGame)' == 'true' or ('$(Configuration)' != 'ExportDebug' and '$(Configuration)' != 'ExportRelease')" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" Condition="'$(GodotMcpCodeExecInGame)' == 'true' or ('$(Configuration)' != 'ExportDebug' and '$(Configuration)' != 'ExportRelease')" />
    <PackageReference Include="com.IvanMurzak.Godot.MCP.Particles" Version="*" />
    <PackageReference Include="com.IvanMurzak.Godot.MCP.Animation" Version="*" />
    <PackageReference Include="com.IvanMurzak.Godot.MCP.Navigation" Version="*" />
    <PackageReference Include="com.IvanMurzak.Godot.MCP.Tilemap" Version="*" />
    <PackageReference Include="com.IvanMurzak.Godot.MCP.Dialogic" Version="*" />
    <PackageReference Include="com.IvanMurzak.Godot.MCP.Terrain3D" Version="*" />
    <PackageReference Include="com.IvanMurzak.Godot.MCP.PhantomCamera" Version="*" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="addons/godot_mcp/extensions.catalog.json" LogicalName="Godot-MCP.extensions.catalog.json" />
  </ItemGroup>
</Project>
